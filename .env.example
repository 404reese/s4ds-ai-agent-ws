# Get one at https://huggingface.co/settings/tokens  (Read access is enough)
# No quotes, no trailing spaces.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Swap this if the default model is busy.
# Alternatives: Qwen/Qwen2.5-7B-Instruct , meta-llama/Llama-3.2-3B-Instruct
MODEL_ID=Qwen/Qwen2.5-72B-Instruct
